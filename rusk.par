%start Rusk
%title "Rusk beta prototype"
%line_comment "//"
%%
Rusk: { Statement };
Statement: Include | StructDef | Function | Return | ExternType | ExternFn | ExternSymbol | Let | Input | Output | If | For | While | Loop | Break | Continue | Block | Expr ';'^;
Include: 'include'^ StringLiteral ';'^;
StructDef: 'struct'^ Identifier [ TypeParameters ] '{'^ { StructField } '}'^;
StructField: Identifier ':'^ TypeName ';'^;
Function: 'fn'^ Identifier [ TypeParameters ] '('^ Parameters ')'^ [ '->'^ TypeName ] Block;
TypeParameters: '<'^ Identifier { ','^ Identifier } '>'^;
Return: 'return' [ Expr ] ';'^;
ExternType: 'extern'^ 'type'^ TypeName '{'^ Properties '}'^;
ExternFn: 'extern'^ 'fn'^ Identifier '('^ Parameters ')'^ [ '->'^ TypeName ] '{'^ Properties '}'^;
ExternSymbol: 'extern'^ 'symbol'^ Identifier '{'^ Properties '}'^;
Parameters: [ Parameter { ','^ Parameter } ];
Parameter: Identifier ':'^ TypeName;
TypeName: NamedType | TupleType;
NamedType: Identifier [ TypeArguments ];
TypeArguments: '<'^ TypeName { ','^ TypeName } '>'^;
TupleType: '('^ TypeName ','^ TypeName { ','^ TypeName } ')'^;
Properties: { Property };
Property: Identifier ':'^ StringLiteral ','^;
Let: 'let'^ Binding [ ':'^ TypeName ] [ LetInitOp Expr ] ';'^;
Binding: Identifier | '(' Binding ','^ Binding { ','^ Binding } ')'^;
LetInitOp: ':=' | '=';
Input: 'in'^ InputItem { ','^ InputItem } ';'^;
InputItem: InputName { ','^ InputName } ':'^ TypeName;
InputName: Identifier [ '('^ ExprList ')'^ ];
Output: 'wt'^ ExprList ';'^;
Block: '{'^ { Statement } '}'^;
ExprList: [ Expr { ','^ Expr } ];
If: 'if'^ Expr Block [ 'else'^ Block ];
For: 'for'^ Binding 'in'^ Expr Block [ 'else'^ Block ];
While: 'while'^ Expr Block [ 'else'^ Block ];
Loop: 'loop'^ Block;
Break: 'break' ';'^;
Continue: 'continue' ';'^;
Expr: Lambda | Range [ AssignOp Expr ];
Range: LogicalOr [ '..'^ LogicalOr ];
LogicalOr: LogicalAnd { '||'^ LogicalAnd };
LogicalAnd: BitOr { '&&'^ BitOr };
BitOr: BitXor { '|'^ BitXor };
BitXor: BitAnd { '^'^ BitAnd };
BitAnd: Compare { '&'^ Compare };
Compare: Add [ CompareOp Add ];
CompareOp: '==' | '!=' | '<' | '<=' | '>' | '>=';
AssignOp: ':=' | '=' | '+=' | '-=' | '*=' | '/=' | '%=';
Add: Mul { AddOp Mul };
AddOp: '+' | '-';
Mul: Unary { MulOp Unary };
MulOp: '*' | '/' | '%';
Unary: UnaryOp Unary | Postfix;
Postfix: Primary { Suffix };
Suffix: Index | Member | Invoke;
Invoke: '('^ ExprList ')'^;
Member: '.'^ Identifier;
Index: '[' Expr ']'^;
UnaryOp: '+' | '-' | '!';
Array: '[' [ Expr ArrayTail ] ']'^;
ArrayTail: ';'^ Expr | { ','^ Expr };
Primary: Array | Literal | Reference [ RecordFields ] | '(' Expr [ TupleTail ] ')'^;
Lambda: '(' Parameters ')'^ '=>'^ Expr;
Reference: Identifier [ '::'^ TypeArguments ];
TupleTail: ','^ Expr { ','^ Expr } [ ','^ ];
RecordFields: '{'^ FieldValue { ','^ FieldValue } [ ','^ ] '}'^;
FieldValue: Identifier ':'^ Expr;
Literal: IntLiteral | StringLiteral | CharLiteral | BoolLiteral;
BoolLiteral: 'true' | 'false';
IntLiteral: /[0-9]+/;
StringLiteral: /"(\\.|[^"\\])*"/;
CharLiteral: /'(\\.|[^'\\])'/;
Identifier: /[a-zA-Z_][a-zA-Z0-9_]*/;
